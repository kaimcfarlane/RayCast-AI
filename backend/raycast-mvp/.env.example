# Copy to .env and fill in values. Never commit .env.

# Required for AI routes (analyze-stream, chat, vision, TTS, STT)
OPENAI_API_KEY=

# Required when using Firebase upload / auth routes
FIREBASE_BUCKET=
# Optional: path to service account JSON (defaults: firebase-key.json in this directory)
# FIREBASE_CREDENTIALS_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional: if ffmpeg is not on PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Server port (default 8000)
# PORT=8000
